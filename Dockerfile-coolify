FROM node:20.18.0

WORKDIR /app

# Install necessary dependencies
RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*

# Enable pnpm and install wrangler
RUN corepack enable pnpm && npm install -g wrangler

# Copy package files first for caching
COPY package.json pnpm-lock.yaml ./

# Force install dependencies to ensure architecture compatibility
RUN pnpm install --ignore-scripts && pnpm rebuild

# Copy application source code
COPY . .

# Ensure bindings.sh has the correct format and permissions
RUN tr -d '\r' < bindings.sh > bindings.tmp && \
    mv bindings.tmp bindings.sh && \
    chmod +x bindings.sh

# Check and install workerd manually if missing
RUN if [ ! -f "/app/node_modules/.pnpm/@cloudflare+workerd-linux-arm64/bin/workerd" ]; then \
    echo "Installing missing workerd binary..."; \
    pnpm add @cloudflare/workerd-linux-arm64; \
  fi

# Build application with debug logs enabled
RUN pnpm run build || (echo "Build failed, printing logs..." && cat /app/build.log && exit 1)

# Expose necessary port
EXPOSE 5173

# Set environment variables
ENV NODE_ENV=production \
    RUNNING_IN_DOCKER=true

# Start the application
CMD ["pnpm", "run", "dockerstart"]
