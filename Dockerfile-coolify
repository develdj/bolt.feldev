FROM node:20.18.0

WORKDIR /app

# Install necessary dependencies
RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*

# Install PNPM and global dependencies
RUN npm install -g pnpm@latest wrangler \
    && rm -rf ~/.cache/corepack

# Copy package files first (Optimized caching)
COPY package.json pnpm-lock.yaml ./

# Install dependencies
RUN pnpm install --ignore-scripts && pnpm rebuild

# Copy application source code
COPY . .

# Ensure bindings.sh has the correct format and permissions
RUN tr -d '\r' < bindings.sh > bindings.tmp && \
    mv bindings.tmp bindings.sh && \
    chmod +x bindings.sh

# Check and install workerd manually if missing
RUN if [ ! -f "$(pnpm bin)/workerd" ]; then \
    echo "Installing missing workerd binary..."; \
    pnpm add --save-dev @cloudflare/workerd-linux-arm64; \
  fi

# Build application
RUN pnpm run build

# Expose necessary port
EXPOSE 5173

# Set environment variables
ENV NODE_ENV=production \
    RUNNING_IN_DOCKER=true

# Start the application
CMD ["pnpm", "run", "dockerstart"]
