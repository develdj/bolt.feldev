# Use an ARM64-compatible base image for NVIDIA Jetson Orin AGX
ARG BASE=node:20-alpine
FROM ${BASE} AS base

# Set working directory
WORKDIR /app

# Install dependencies (cached)
COPY package.json pnpm-lock.yaml ./

# Install necessary dependencies
RUN apk add --no-cache git && \
    npm install -g corepack && corepack enable pnpm && \
    pnpm install --force && \
    pnpm add @cloudflare/workerd-linux-arm64

# Fix permission issues for workerd binary
RUN chmod +x $(find /app/node_modules/.pnpm -name workerd)

# Install Wrangler globally
RUN npm install -g wrangler

# Copy application source code
COPY . .

# Ensure the bindings.sh script has the correct format and permissions
RUN tr -d '\r' < bindings.sh > bindings.tmp && \
    mv bindings.tmp bindings.sh && \
    chmod +x bindings.sh

# Build the application
RUN pnpm run build

# Expose the necessary port
EXPOSE 5173

# Set environment variables
ENV NODE_ENV=production \
    RUNNING_IN_DOCKER=true

# Pre-configure wrangler to disable metrics
RUN mkdir -p /root/.config/.wrangler && \
    echo '{"enabled":false}' > /root/.config/.wrangler/metrics.json

# Start the application
CMD ["pnpm", "run", "dockerstart"]
